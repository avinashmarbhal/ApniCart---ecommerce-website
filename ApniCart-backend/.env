# -------------------------
# Server Configuration
# -------------------------
PORT=       # The port your server will run on (e.g., 5000 or 8080)
NODE_ENV=production   # "development" | "production" | "test"

# -------------------------
# Database Configuration
# -------------------------
MONGO_URI=
# Replace "userName" and "Password" with actual MongoDB Atlas credentials.
# "ApniCart" is the database name. Change if needed.

# -------------------------
# JWT Authentication
# -------------------------
ACCESS_TOKEN_SECRET=Xe8QvtbqO
ACCESS_TOKEN_EXPIRY=1d         # How long the access token is valid (e.g., 1d = 1 day)

REFRESH_TOKEN_SECRET=DCXSHkVuJ
REFRESH_TOKEN_EXPIRY=7d        # How long the refresh token is valid (e.g., 7d = 7 days)

# -------------------------
# Cloudinary (Image Uploads)
# -------------------------
CLOUDINARY_CLOUD_NAME=         # Add your Cloudinary Cloud name here
CLOUDINARY_API_KEY=            # Add your Cloudinary API key here
CLOUDINARY_API_SECRET=         # Add your Cloudinary API secret here
# Needed for uploading and managing images in Cloudinary.

# -------------------------
# Email Configuration (for nodemailer, OTPs, notifications)
# -------------------------
EMAIL_USER=apnicart07@gmail.com
EMAIL_PASS=xyz   # Use an App Password if using Gmail, not your actual Gmail password.
# This is used to send emails (like OTPs, order confirmation, etc.)
